<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daniel.shutdownchime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/daniel/Library/Scripts/imac-shutdown-chime.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>AlwaysSIGTERMOnShutdown</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/imac-shutdown-chime.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/imac-shutdown-chime.err</string>
</dict>
</plist>
